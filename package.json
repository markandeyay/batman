{
  "name": "batman",
  "private": true,
  "version": "0.0.1",
  "description": "Batman: an iMessage-only personal safety agent built on Photon. See docs/BATMAN_SPEC.md.",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "tsx scripts/doctor.ts",
    "dev": "pnpm --filter @batman/server dev",
    "chat": "cross-env ENABLE_TERMINAL=1 LOCATION_SOURCE=replay pnpm --filter @batman/server dev",
    "typecheck": "tsc -b",
    "lint": "eslint . && tsx scripts/check-copy.ts",
    "test": "vitest run",
    "test:sim": "vitest run tests/sim",
    "evals": "tsx tests/evals/run.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm evals",
    "e2e:probe": "tsx apps/probe/src/index.ts",
    "live:guide": "tsx scripts/live-guide.ts",
    "spike": "tsx scripts/spike.ts"
  },
  "devDependencies": {
    "@livekit/protocol": "1.51.0",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "livekit-server-sdk": "2.19.1",
    "rimraf": "^6.1.3",
    "spectrum-ts": "12.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "dependencies": {
    "@photon-ai/advanced-imessage": "2.2.0",
    "@spectrum-ts/imessage": "12.10.1",
    "zod": "4.6.5"
  }
}
