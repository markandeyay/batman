# Batman environment variables (spec Section 19).
# Copy this file to .env and fill in values. Never commit .env.
# Claude Code is denied read access to .env; only the app loads it at runtime.

# ---- Photon / Spectrum (required) ----
SPECTRUM_PROJECT_ID=            # Photon project ID (also the SIP username)
SPECTRUM_PROJECT_SECRET=        # Photon project secret (also the SIP password)
BATMAN_LINE_E164=               # Batman's iMessage line in E.164, e.g. +19195550100 (caller ID for calls)
IMESSAGE_GRPC_ADDRESS=          # advanced-imessage host:port, no scheme. Only if Spike S1 needs it.

# ---- LLM / speech (required) ----
OPENAI_API_KEY=                 # LLM, STT, TTS
LLM_PROVIDER=openai             # openai (default) or anthropic
ANTHROPIC_API_KEY=              # only if LLM_PROVIDER=anthropic
LLM_MODEL_SMART=                # extraction and classification model (pick a current model from provider docs)
LLM_MODEL_FAST=                 # optional: small talk and copy phrasing
STT_MODEL=                      # transcription model
TTS_MODEL=                      # text-to-speech model
TTS_VOICE=                      # text-to-speech voice

# ---- Calls via LiveKit Cloud (required only if calls are enabled) ----
LIVEKIT_URL=                    # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=           # outbound trunk to sip.spectrum.photon.codes (created by a setup script)

# ---- Geocoding (required) ----
GEOCODER=nominatim              # mapbox, google, or nominatim
GEOCODER_API_KEY=               # per provider. Nominatim needs a contact email in User-Agent and max 1 req/s.

# ---- Runtime (required) ----
DATABASE_PATH=./data/batman.db
DEFAULT_TZ=America/New_York

# ---- Optional ----
FFMPEG_PATH=                    # only if ffmpeg is not on PATH
TIME_SCALE=1                    # 60 means one real second equals one simulated minute
LOCATION_SOURCE=findmy          # findmy (default), pin, replay, none
REPLAY_TRACK=                   # path to a track JSON when LOCATION_SOURCE=replay
ENABLE_TERMINAL=0               # 1 enables the console provider (pnpm chat)
DEMO_MODE=0                     # enables /ff and demo copy tweaks
TEST_MODE=0                     # enables the loopback control port
TEST_CONTROL_PORT=4747
ADMIN_NUMBERS=                  # comma-separated E.164 numbers allowed to send admin commands
LOG_LEVEL=info

# ---- Live testing ----
HUMAN_IPHONE_E164=              # your iPhone number for spikes and the guided session
TEST_GUARDIAN_E164=             # a consenting guardian phone for live tests
PROBE_PROJECT_ID=               # second Photon project for the probe line (spec 16.3)
PROBE_PROJECT_SECRET=
